   },
   {
    "article": "0001_3",
    "chrf": 33.7,
    "plancher": 32.46,
    "hasard": 12.38,
    "sortie": "His bicycle waa too short.",
    "longueur_sortie": 26,
    "longueur_ref": 29,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_4",
    "chrf": 16.84,
    "plancher": 17.36,
