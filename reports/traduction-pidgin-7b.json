  "details": [
   {
    "article": "0001_0",
    "chrf": 11.05,
    "plancher": 15.3,
    "hasard": 6.06,
    "sortie": "How are you doing.",
    "longueur_sortie": 18,
    "longueur_ref": 22,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_1",
    "chrf": 18.13,
    "plancher": 19.27,
    "hasard": 14.12,
    "sortie": "Open the door to enter the house.",
    "longueur_sortie": 33,
    "longueur_ref": 24,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_2",
    "chrf": 14.89,
    "plancher": 18.82,
    "hasard": 7.08,
    "sortie": "He is wearing a hat.",
    "longueur_sortie": 20,
    "longueur_ref": 22,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_3",
    "chrf": 35.2,
    "plancher": 34.82,
    "hasard": 12.69,
    "sortie": "The bicycle is red.",
    "longueur_sortie": 19,
    "longueur_ref": 26,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_4",
    "chrf": 19.67,
    "plancher": 22.69,
    "hasard": 14.39,
    "sortie": "Duty is a long and not a small thing.",
    "longueur_sortie": 37,
    "longueur_ref": 22,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_5",
    "chrf": 25.66,
    "plancher": 36.3,
    "hasard": 9.83,
    "sortie": "How hand construct along long size.",
    "longueur_sortie": 35,
    "longueur_ref": 31,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_6",
    "chrf": 31.76,
    "plancher": 25.62,
    "hasard": 12.89,
    "sortie": "D door body e make sef dey tall. translates to \"The door frame makes itself stand tall.\"",
    "longueur_sortie": 88,
    "longueur_ref": 30,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_7",
    "chrf": 19.27,
    "plancher": 22.91,
    "hasard": 4.12,
    "sortie": "In every single size.",
    "longueur_sortie": 21,
    "longueur_ref": 24,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_8",
    "chrf": 33.14,
    "plancher": 29.72,
    "hasard": 7.88,
    "sortie": "I need to buy a tall bicycle.",
    "longueur_sortie": 29,
    "longueur_ref": 30,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_9",
    "chrf": 31.12,
    "plancher": 31.14,
    "hasard": 14.76,
    "sortie": "For the tall chair. Come take the long fork to chop.",
    "longueur_sortie": 52,
    "longueur_ref": 58,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_10",
    "chrf": 31.16,
    "plancher": 24.27,
    "hasard": 15.81,
    "sortie": "E left his house to come patch up one kain bush. E didn't stay there.",
    "longueur_sortie": 69,
    "longueur_ref": 69,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_0",
    "chrf": 57.02,
    "plancher": 34.92,
    "hasard": 22.28,
    "sortie": "Goat, Dog, and Malu are friends. One day they went traveling inside a moto.",
    "longueur_sortie": 75,
    "longueur_ref": 80,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_1",
    "chrf": 37.91,
    "plancher": 28.88,
    "hasard": 28.41,
    "sortie": "When they reach where they go, then the driver comes asking for money. Malu pays his own.",
    "longueur_sortie": 89,
    "longueur_ref": 104,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_2",
    "chrf": 15.92,
    "plancher": 15.92,
    "hasard": 10.52,
    "sortie": "Dog put small moni join as em moni no complete",
    "longueur_sortie": 46,
    "longueur_ref": 64,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_3",
    "chrf": 38.75,
    "plancher": 35.0,
    "hasard": 15.84,
    "sortie": "D drive bin want give Dog change when goat take style run, e no pay oh.",
    "longueur_sortie": 71,
    "longueur_ref": 87,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_4",
    "chrf": 32.03,
    "plancher": 28.42,
    "hasard": 16.92,
    "sortie": "D driver's vexation is not small so he won't give Dog a chance to change himself.",
    "longueur_sortie": 81,
    "longueur_ref": 73,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_5",
    "chrf": 39.95,
    "plancher": 39.06,
    "hasard": 12.87,
    "sortie": "Until today, na so Dog da run follow car to check if na driver went to owe am change dey inside",
    "longueur_sortie": 95,
    "longueur_ref": 107,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_6",
    "chrf": 25.59,
    "plancher": 18.78,
    "hasard": 13.5,
    "sortie": "Goat on his own level doesn't try to get near the motorbike. He fears that if he is caught coming to pay the money I owe, it won't be good.",
    "longueur_sortie": 139,
    "longueur_ref": 99,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_7",
    "chrf": 33.87,
    "plancher": 20.72,
    "hasard": 16.18,
    "sortie": "The cow won't go whether the motorcycle comes or not. The ram is standing by the road because he owes nobody.",
    "longueur_sortie": 109,
    "longueur_ref": 127,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_0",
    "chrf": 62.14,
    "plancher": 49.62,
    "hasard": 20.49,
    "sortie": "Na Khalai is a girl. She is seven years old. In their dialect, the meaning of her name is 'good one', which is for the Lubukusu language.",
    "longueur_sortie": 137,
    "longueur_ref": 96,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_1",
    "chrf": 55.4,
    "plancher": 48.03,
    "hasard": 21.06,
    "sortie": "Khalai woke up and began with an orange tree. \"Please orange tree, grow so we can have plenty oranges when ripe.\"",
    "longueur_sortie": 113,
    "longueur_ref": 110,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_2",
    "chrf": 44.94,
    "plancher": 40.99,
    "hasard": 15.66,
    "sortie": "Khalai went to school late. Since there was no road, she went walking with grass. “Come on, grass, grow to keep you fresh and prevent you from dying.”",
    "longueur_sortie": 150,
    "longueur_ref": 105,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_3",
    "chrf": 41.57,
    "plancher": 40.05,
    "hasard": 15.16,
    "sortie": "Khalai waka passed by a bush flower. \"Hey flower, make you grow nice and pretty so that I can use you for my hair.\"",
    "longueur_sortie": 115,
    "longueur_ref": 88,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_4",
    "chrf": 57.07,
    "plancher": 54.04,
    "hasard": 9.21,
    "sortie": "For school, Khalai go talk to tree wen dey center of compound. \"Abeg oo tree, make ur branches dey spreed oo make we for fit dey siddon read under your shade oo.\" \n\nTranslation:\nAt school, Khalai went to talk to the tree which was at the center of the compound. \"Please tree, spread your branches so that we can sit and read under your shade.\"",
    "longueur_sortie": 343,
    "longueur_ref": 135,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_5",
    "chrf": 42.49,
    "plancher": 41.11,
    "hasard": 15.98,
    "sortie": "Khalai dey yan to flower wen surround her school. “Abeg oo flower, make grow strong oo so yye person no go fit enter our school.” \n\nTranslation:\nThe flowers around her school are blooming. \"Hey flowers, make sure those people aren't strong enough to enter our school.\"",
    "longueur_sortie": 268,
    "longueur_ref": 101,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_6",
    "chrf": 49.06,
    "plancher": 44.18,
    "hasard": 23.61,
    "sortie": "When Wen Khalai came back to school, she went to ask the orange tree, \"Your oranges never get ripe?\"",
    "longueur_sortie": 100,
    "longueur_ref": 107,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_7",
    "chrf": 42.34,
    "plancher": 45.4,
    "hasard": 14.0,
    "sortie": "\"D orange dem still never ripe oo\" hmmmn. \"I go see you tomorrow oo orange tree,\" \"maybe tomorrow go beta and I fit get ripe orange for myself!\"",
    "longueur_sortie": 144,
    "longueur_ref": 147,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_0",
    "chrf": 41.69,
    "plancher": 29.28,
    "hasard": 18.31,
    "sortie": "My little brother says he sleeps well. I'll get up quickly as a bigger boy!",
    "longueur_sortie": 75,
    "longueur_ref": 69,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_1",
    "chrf": 17.48,
    "plancher": 20.88,
    "hasard": 12.31,
    "sortie": "I will let him enter inside.",
    "longueur_sortie": 28,
    "longueur_ref": 33,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_2",
    "chrf": 22.92,
    "plancher": 22.92,
    "hasard": 13.28,
    "sortie": "You be my shine shine bobo mama go say.",
    "longueur_sortie": 39,
    "longueur_ref": 34,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_3",
    "chrf": 31.15,
    "plancher": 29.34,
    "hasard": 6.46,
    "sortie": "I know myself nobody dey help me.",
    "longueur_sortie": 33,
    "longueur_ref": 37,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_4",
    "chrf": 59.74,
    "plancher": 58.88,
    "hasard": 22.63,
    "sortie": "I don't fear cold water and blue soap when they smell.",
    "longueur_sortie": 54,
    "longueur_ref": 48,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_5",
    "chrf": 27.84,
    "plancher": 24.99,
    "hasard": 22.02,
    "sortie": "Mama said not to forget your teeth! I will tell him not to shake them.",
    "longueur_sortie": 70,
    "longueur_ref": 59,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_6",
    "chrf": 41.39,
    "plancher": 33.76,
    "hasard": 14.66,
    "sortie": "When I finish bathing, I go salute grandpapa and aunty, and tell them to make today beta oo.",
    "longueur_sortie": 92,
    "longueur_ref": 68,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_7",
    "chrf": 28.89,
    "plancher": 35.54,
    "hasard": 13.92,
    "sortie": "I go wear my clothes by myself, \"I tell Mama I'm a bigger boy.\"",
    "longueur_sortie": 63,
    "longueur_ref": 45,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_8",
    "chrf": 56.86,
    "plancher": 53.28,
    "hasard": 12.7,
    "sortie": "I can button my clothes and tie my shoes.",
    "longueur_sortie": 41,
    "longueur_ref": 43,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_9",
    "chrf": 49.42,
    "plancher": 39.76,
    "hasard": 11.07,
    "sortie": "I tell my little brother all the gossip from school.",
    "longueur_sortie": 52,
    "longueur_ref": 57,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_10",
    "chrf": 19.26,
    "plancher": 20.62,
    "hasard": 16.45,
    "sortie": "For school, I try as my power allows me.",
    "longueur_sortie": 40,
    "longueur_ref": 35,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_11",
    "chrf": 49.94,
    "plancher": 40.84,
    "hasard": 20.51,
    "sortie": "I do plenty things every day. But playing is what I like to pass time.",
    "longueur_sortie": 70,
    "longueur_ref": 85,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_0",
    "chrf": 34.95,
    "plancher": 40.98,
    "hasard": 18.18,
    "sortie": "Tingi de stay with grandma. (This sentence is already in English. The translation is the same.)",
    "longueur_sortie": 95,
    "longueur_ref": 33,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_1",
    "chrf": 42.52,
    "plancher": 33.56,
    "hasard": 13.94,
    "sortie": "And they take care of the cow with her.",
    "longueur_sortie": 39,
    "longueur_ref": 40,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_2",
    "chrf": 86.84,
    "plancher": 64.3,
    "hasard": 12.03,
    "sortie": "One day the soldiers come.",
    "longueur_sortie": 26,
    "longueur_ref": 26,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_3",
    "chrf": 39.72,
    "plancher": 39.72,
    "hasard": 16.13,
    "sortie": "Dem come carry the cows go.",
    "longueur_sortie": 27,
    "longueur_ref": 24,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_4",
    "chrf": 28.91,
    "plancher": 38.7,
    "hasard": 11.98,
    "sortie": "Tingi and I run to hide.",
    "longueur_sortie": 24,
    "longueur_ref": 43,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_5",
    "chrf": 36.59,
    "plancher": 36.82,
    "hasard": 8.87,
    "sortie": "Dem hide for bush till night comes.",
    "longueur_sortie": 35,
    "longueur_ref": 33,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_6",
    "chrf": 55.69,
    "plancher": 65.42,
    "hasard": 15.19,
    "sortie": "The soldiers' den comes back.",
    "longueur_sortie": 29,
    "longueur_ref": 28,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_7",
    "chrf": 77.5,
    "plancher": 59.64,
    "hasard": 17.66,
    "sortie": "Grandma came and hid Tingi under the leaves.",
    "longueur_sortie": 44,
    "longueur_ref": 39,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_8",
    "chrf": 28.14,
    "plancher": 27.06,
    "hasard": 19.35,
    "sortie": "One soldier carries the leg on top and there is no shaking at all.",
    "longueur_sortie": 66,
    "longueur_ref": 65,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_9",
    "chrf": 57.76,
    "plancher": 42.56,
    "hasard": 16.92,
    "sortie": "When the sun goes down, Tingi and his grandma come out.",
    "longueur_sortie": 55,
    "longueur_ref": 53,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_10",
    "chrf": 20.41,
    "plancher": 16.2,
    "hasard": 12.96,
    "sortie": "The creep went to a small house small.",
    "longueur_sortie": 38,
    "longueur_ref": 29,
    "tronque": false,
    "recopie": false
   }
  ]
 }
]