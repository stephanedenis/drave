    "sortie": "Dis man too tall!",
    "longueur_sortie": 17,
    "longueur_ref": 34,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_5",
    "chrf": 31.36,
    "plancher": 31.93,
    "hasard": 10.19,
    "sortie": "He make very long hoe handle.",
    "longueur_sortie": 29,
    "longueur_ref": 38,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_6",
    "chrf": 32.82,
    "plancher": 24.61,
    "hasard": 11.99,
    "sortie": "He make very high door frame strongs.",
    "longueur_sortie": 37,
    "longueur_ref": 32,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_7",
    "chrf": 21.87,
    "plancher": 22.91,
    "hasard": 4.36,
    "sortie": "He make very long bed.",
    "longueur_sortie": 22,
    "longueur_ref": 24,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_8",
    "chrf": 50.19,
    "plancher": 33.38,
    "hasard": 8.63,
    "sortie": "He buy a very high bicycle = He buy a bicycle very tall.",
    "longueur_sortie": 56,
    "longueur_ref": 25,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_9",
    "chrf": 32.76,
    "plancher": 33.32,
    "hasard": 19.6,
    "sortie": "He sat on a very high chair. He eat with a very long fork:\nHe sat on a chieh ahm dey high. He eat with a fork ahm dey long.",
    "longueur_sortie": 123,
    "longueur_ref": 52,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0001_10",
    "chrf": 27.64,
    "plancher": 25.17,
    "hasard": 13.74,
    "sortie": "He go leave haus himna, stay in big forest. He stay dey for many years.",
    "longueur_sortie": 71,
    "longueur_ref": 65,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_0",
    "chrf": 30.17,
    "plancher": 35.75,
    "hasard": 19.44,
    "sortie": "Goat, dog, an cow wete greet frends. Ome day dey go a jorney in a taxi.",
    "longueur_sortie": 71,
    "longueur_ref": 77,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_1",
    "chrf": 36.82,
    "plancher": 32.88,
    "hasard": 20.08,
    "sortie": "When dey reach de end of de journey, de driver ask dem pay de fare. Cow pay her fare.",
    "longueur_sortie": 85,
    "longueur_ref": 84,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_2",
    "chrf": 21.18,
    "plancher": 19.44,
    "hasard": 13.49,
    "sortie": "Dog pay a little extra, because he no have de correct money.",
    "longueur_sortie": 60,
    "longueur_ref": 46,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_3",
    "chrf": 36.25,
    "plancher": 40.32,
    "hasard": 12.65,
    "sortie": "The driver pene give Dog gole him money when Goat run fi go without pay nothing.",
    "longueur_sortie": 80,
    "longueur_ref": 69,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_4",
    "chrf": 25.75,
    "plancher": 33.79,
    "hasard": 12.68,
    "sortie": "Devera noyed much. He drove gobi without gi Dogi his change.",
    "longueur_sortie": 60,
    "longueur_ref": 55,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_5",
    "chrf": 46.18,
    "plancher": 41.73,
    "hasard": 13.94,
    "sortie": "Dat is why, even today, Dog go run towards car gwaan check inside fi dey find driver no pay him his change money.",
    "longueur_sortie": 113,
    "longueur_ref": 96,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_6",
    "chrf": 21.04,
    "plancher": 18.23,
    "hasard": 13.18,
    "sortie": "Goat run faim fi dey escape car. She fey fear she no pay fare so dey arrest her.",
    "longueur_sortie": 80,
    "longueur_ref": 104,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_7",
    "chrf": 32.21,
    "plancher": 25.32,
    "hasard": 21.28,
    "sortie": "An cow no worry when go dey come car. Cow take her time fini cross road because she know she pay her fare full.",
    "longueur_sortie": 111,
    "longueur_ref": 91,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_0",
    "chrf": 43.16,
    "plancher": 46.44,
    "hasard": 17.32,
    "sortie": "Dis is Khalai. She dey seven years old. Name she mean 'de good one' in her language, Lubukusu.",
    "longueur_sortie": 94,
    "longueur_ref": 107,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_1",
    "chrf": 36.26,
    "plancher": 45.79,
    "hasard": 24.12,
    "sortie": "Khalai fi wake na talk to dey tree ya sii orange. \"Plis dey tree ya sii, gbama big and drop lots of ripe orange foh.\"",
    "longueur_sortie": 117,
    "longueur_ref": 119,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_2",
    "chrf": 30.3,
    "plancher": 35.84,
    "hasard": 19.02,
    "sortie": "Khalai go dey school. Inna way she talk to grai. \"Pleas grai, grow greeen an don't dry up.\"",
    "longueur_sortie": 91,
    "longueur_ref": 131,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_3",
    "chrf": 28.64,
    "plancher": 35.97,
    "hasard": 17.01,
    "sortie": "Khalai pas wild flowers. \"Please flowers, keep blooming so I can put yu in mi head.\"",
    "longueur_sortie": 84,
    "longueur_ref": 105,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_4",
    "chrf": 43.85,
    "plancher": 48.38,
    "hasard": 14.96,
    "sortie": "In da school, Khalai talk to de tree in middle of de compound. \"Please tree, put big branch so we can reed under yu shade.\"",
    "longueur_sortie": 123,
    "longueur_ref": 162,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_5",
    "chrf": 32.49,
    "plancher": 35.26,
    "hasard": 22.54,
    "sortie": "Khalai talk to de bush round di school ya say: \"Plis go grow strong so dey stop big people no come in.\"",
    "longueur_sortie": 103,
    "longueur_ref": 130,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_6",
    "chrf": 43.76,
    "plancher": 46.04,
    "hasard": 23.37,
    "sortie": "When Khalai go school fini, she go visit de orange tree. \"Li yuor orange dekun yet?\" aska Khalai.",
    "longueur_sortie": 97,
    "longueur_ref": 100,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_7",
    "chrf": 40.74,
    "plancher": 46.17,
    "hasard": 18.14,
    "sortie": "\"Dey still green\" mo sigh Khalai. \"Mo see you tomorrow orange tree\" mo say Khalai. \"Mighty dey ripe orange for me den!\"",
    "longueur_sortie": 119,
    "longueur_ref": 143,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_0",
    "chrf": 22.12,
    "plancher": 28.52,
    "hasard": 20.8,
    "sortie": "Mi lil bro sleep very late. Mi wake early, because mi be great!",
    "longueur_sortie": 63,
    "longueur_ref": 72,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_1",
    "chrf": 27.74,
    "plancher": 21.7,
    "hasard": 18.76,
    "sortie": "Me be de one who let in de sun.",
    "longueur_sortie": 31,
    "longueur_ref": 31,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_2",
    "chrf": 22.68,
    "plancher": 21.07,
    "hasard": 11.97,
    "sortie": "Yuo be ma morning star,\" say Ma.",
    "longueur_sortie": 32,
    "longueur_ref": 39,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_3",
    "chrf": 29.17,
    "plancher": 29.34,
    "hasard": 8.8,
    "sortie": "Me wash mi body, me no need any help.",
    "longueur_sortie": 37,
    "longueur_ref": 37,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_4",
    "chrf": 54.95,
    "plancher": 56.0,
    "hasard": 21.69,
    "sortie": "Me cop with cold water bilong dey and blue smelly soap.",
    "longueur_sortie": 55,
    "longueur_ref": 52,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_5",
    "chrf": 24.95,
    "plancher": 23.77,
    "hasard": 16.96,
    "sortie": "Ma remind, \"No dey forget teeth.\" Me reply, \"No dey, no meh!\"",
    "longueur_sortie": 61,
    "longueur_ref": 64,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_6",
    "chrf": 22.09,
    "plancher": 28.11,
    "hasard": 14.8,
    "sortie": "After washin', I greet Daad and Aunt, an wish dem good day.",
    "longueur_sortie": 59,
    "longueur_ref": 92,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_7",
    "chrf": 17.58,
    "plancher": 27.85,
    "hasard": 9.9,
    "sortie": "Now I dress mi self, \"Mi big now Ma,\" mi say.",
    "longueur_sortie": 45,
    "longueur_ref": 67,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_8",
    "chrf": 56.17,
    "plancher": 59.65,
    "hasard": 11.34,
    "sortie": "Me fin shut my button an fi tie my shoelace.",
    "longueur_sortie": 44,
    "longueur_ref": 36,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_9",
    "chrf": 28.36,
    "plancher": 41.59,
    "hasard": 12.8,
    "sortie": "An I make shure littil brudder know all de school news.",
    "longueur_sortie": 55,
    "longueur_ref": 53,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_10",
    "chrf": 14.94,
    "plancher": 18.72,
    "hasard": 12.9,
    "sortie": "In class mi do mi best every way.",
    "longueur_sortie": 33,
    "longueur_ref": 41,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0095_11",
    "chrf": 53.54,
    "plancher": 52.14,
    "hasard": 16.75,
    "sortie": "I do all dis good things every day. But de thing I like most is play play!",
    "longueur_sortie": 74,
    "longueur_ref": 57,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_0",
    "chrf": 28.6,
    "plancher": 46.57,
    "hasard": 8.24,
    "sortie": "Tingi livi wid de gobernment.",
    "longueur_sortie": 29,
    "longueur_ref": 27,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_1",
    "chrf": 24.73,
    "plancher": 37.16,
    "hasard": 15.7,
    "sortie": "He use to look after de cows diim dey work.",
    "longueur_sortie": 43,
    "longueur_ref": 34,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_2",
    "chrf": 88.01,
    "plancher": 71.82,
    "hasard": 15.15,
    "sortie": "One day de soldiers come.",
    "longueur_sortie": 25,
    "longueur_ref": 22,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_3",
    "chrf": 36.99,
    "plancher": 36.79,
    "hasard": 16.99,
    "sortie": "De take dey cows go.",
    "longueur_sortie": 20,
    "longueur_ref": 27,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_4",
    "chrf": 50.29,
    "plancher": 44.04,
    "hasard": 11.11,
    "sortie": "Tingi an his granma run dey hide.",
    "longueur_sortie": 33,
    "longueur_ref": 35,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_5",
    "chrf": 42.74,
    "plancher": 36.13,
    "hasard": 8.47,
    "sortie": "De hide in bush tilli night временна ошибка, попробуйте снова",
    "longueur_sortie": 61,
    "longueur_ref": 34,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_6",
    "chrf": 51.14,
    "plancher": 66.99,
    "hasard": 10.54,
    "sortie": "De soldiers come go.",
    "longueur_sortie": 20,
    "longueur_ref": 27,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_7",
    "chrf": 59.69,
    "plancher": 61.66,
    "hasard": 11.32,
    "sortie": "Grandmama hide Tingi in da leaves.",
    "longueur_sortie": 34,
    "longueur_ref": 37,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_8",
    "chrf": 16.49,
    "plancher": 31.04,
    "hasard": 11.62,
    "sortie": "A solider put his foot rite diim, but he keep quiet.",
    "longueur_sortie": 52,
    "longueur_ref": 52,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_9",
    "chrf": 48.0,
    "plancher": 46.49,
    "hasard": 20.03,
    "sortie": "When it was safe, Tingi and de goyam come out.",
    "longueur_sortie": 46,
    "longueur_ref": 46,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0210_10",
    "chrf": 24.49,
    "plancher": 15.55,
    "hasard": 14.09,
    "sortie": "Dey creep home very quiet.",
    "longueur_sortie": 26,
    "longueur_ref": 31,
    "tronque": false,
    "recopie": false
   }
  ]
 },
 {
