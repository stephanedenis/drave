   {
    "article": "0089_0",
    "chrf": 44.03,
    "plancher": 46.44,
    "hasard": 19.1,
    "sortie": "Dis dey Khalai. Shi seven year old. Her name dey fit mean \"the good one\" in her language, Lubukusu.",
