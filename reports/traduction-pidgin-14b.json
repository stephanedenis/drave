    "recopie": false
   },
   {
    "article": "0004_5",
    "chrf": 48.14,
    "plancher": 41.73,
    "hasard": 13.61,
    "sortie": "Dat is why, even today, Dog run go car plenty road fit look inside say find am driver wey owe am change.",
