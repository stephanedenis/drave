    "longueur_ref": 69,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_4",
    "chrf": 35.73,
    "plancher": 33.79,
    "hasard": 15.18,
    "sortie": "The driver don catch plenty anger. Him drive go far without give change to Dog.",
    "longueur_sortie": 79,
