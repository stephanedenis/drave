    "recopie": false
   },
   {
    "article": "0004_0",
    "chrf": 40.46,
    "plancher": 35.75,
    "hasard": 16.63,
    "sortie": "Goat, Dog, and Cow don be good friend. One day them go go trip inside taxi.",
