    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_3",
    "chrf": 37.74,
    "plancher": 40.32,
    "hasard": 13.66,
    "sortie": "The driver wan ready give Dog money wey him dey owe am when Goat run way no dey pay anything.",
