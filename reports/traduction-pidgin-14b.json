   },
   {
    "article": "0004_1",
    "chrf": 42.9,
    "plancher": 32.88,
    "hasard": 21.43,
    "sortie": "Wen dem reach finish wetin dey for road, driver ask dem pay money for ride am. Cow pay money for am self.",
    "longueur_sortie": 105,
    "longueur_ref": 84,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0004_2",
    "chrf": 33.36,
    "plancher": 19.44,
    "hasard": 14.68,
    "sortie": "Dog wan pay small more money because he no de correct money.",
    "longueur_sortie": 60,
