    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_1",
    "chrf": 53.92,
    "plancher": 45.79,
    "hasard": 21.36,
    "sortie": "Khalai wake up dey talk wan orange tree. \"Please orange tree, grow big and plenty ripe orange don give we.\"",
