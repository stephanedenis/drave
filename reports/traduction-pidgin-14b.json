    "longueur_ref": 119,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_2",
    "chrf": 40.37,
    "plancher": 35.84,
    "hasard": 15.18,
    "sortie": "Khalai wan walk reach school. Be way she dey talk reach grass. \"Sayonse grass, grow more green no dry wetin you dey grow.\"",
    "longueur_sortie": 122,
    "longueur_ref": 131,
    "tronque": false,
    "recopie": false
   },
   {
    "article": "0089_3",
    "chrf": 31.71,
    "plancher": 35.97,
    "hasard": 17.17,
    "sortie": "Khalai pass am wild flowers. \"Please flowers, dey bloom plenty plenty so I can fit am inside my hair.\"",
